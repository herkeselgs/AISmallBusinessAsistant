# --- Folvra environment ---
# Copy to .env.local and fill in. The interactive demo runs WITHOUT any keys
# (deterministic mock mode); set ANTHROPIC_API_KEY to use real Claude.

# Anthropic (AI reply engine). Without it, the demo falls back to mock mode.
ANTHROPIC_API_KEY=

# Model IDs (defaults are sensible; override only if needed)
FOLVRA_DRAFT_MODEL=claude-opus-4-8
FOLVRA_CLASSIFY_MODEL=claude-haiku-4-5-20251001

# Prospect finder (/founder → Find prospects). OPTIONAL.
# If set, the finder uses Google Places (best data). If unset, it falls back to
# free OpenStreetMap data (coverage varies) and CSV/paste import always works.
GOOGLE_PLACES_API_KEY=

# --- Below are for the full authenticated app (later milestone) ---
# Google OAuth (Gmail + Calendar)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Supabase (Postgres + auth store)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
